{
  // Cloudflare, told explicitly rather than guessed.
  //
  // THE RULE HERE CHANGED SHAPE ON 12 AUG 2026, deliberately. It used to say
  // "assets only, no worker script, so a server route cannot quietly appear".
  // Safeer approved the heartbeat middle path (clinic code and app version,
  // opt-in, nothing else) and the super admin panel that reads it, so a
  // script exists now â€” and the rule it lives under is narrower and stated at
  // the top of worker/site.mjs: NOTHING ON THIS WORKER MAY EVER CARRY PATIENT
  // DATA. Two routes, a clinic code, a version string, and contract facts
  // Safeer types himself. The clinical app's only network call is pinned to
  // two fields by a unit test.
  "name": "nuskho",
  "compatibility_date": "2026-08-03",
  "main": "worker/site.mjs",
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS",
    // One page. Any path the worker does not claim serves the app.
    "not_found_handling": "single-page-application"
  },
  // ONE-TIME SETUP, on Safeer's machine (see RUN-THIS):
  //   npx wrangler kv namespace create NKHB
  // then paste the id it prints into the block below and remove the comment
  // marks. Until then the site deploys and serves exactly as before; /hb and
  // /sa answer 503 and store nothing.
  "kv_namespaces": [
    { "binding": "NKHB", "id": "67dfa2ff479840a6813694b48a08eb3f" }
  ],
  /* THE ADDRESS A DOCTOR IS ACTUALLY SENT.
     Until now the only address was nuskho.safeer-ali-mirani.workers.dev,
     which carries a personal name and reads as somebody's test deployment —
     not the thing to put in front of a clinic. larkode.com is already on
     Cloudflare, so this needs no purchase and no DNS wait: wrangler creates
     the record and the certificate on deploy.

     The workers.dev address is deliberately NOT switched off. Every link
     already sent, and the QR square on anything printed from the site, still
     points at it, and a standalone nuskho domain is coming later (Safeer, 29
     Sep 2026) — at which point this becomes the redirect and that becomes the
     address. Nothing clinical rides on either: a clinic opens the app from
     its own folder at localhost:8123, so no record anywhere depends on what
     this worker is called. */
  "routes": [
    { "pattern": "nuskho.larkode.com", "custom_domain": true }
  ],
  /* AND THIS LINE IS WHY THE OLD ADDRESS STILL ANSWERS.
     Wrangler treats a missing `workers_dev` as "off" the moment any route
     exists, and says so only in a warning at the end of a deploy that has
     already happened. The first deploy of the route above took the
     workers.dev address down with it, so every link ever sent 404'd until
     this was added. It is not a default worth trusting to memory: leave it
     written down, true, for as long as that address is one somebody might
     still click. */
  "workers_dev": true,
  // The WhatsApp number the extension button opens. The same number the
  // website already publishes, so nothing new is disclosed by it.
  "vars": { "WA": "923333368189" },
  "observability": { "enabled": false },
  "send_metrics": false
}
