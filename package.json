{
  "name": "nuskho",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vitest run && tsc -b && vite build && vite build --mode demo --base=/ --outDir=dist-web && node scripts/weblayout.mjs",
    "preview": "vite preview",
    "clinic": "vite build && start chrome --kiosk-printing --allow-file-access-from-files \"%CD%\\dist\\index.html\"",
    "build:web": "vite build --mode demo --base=/ --outDir=dist-web && node scripts/weblayout.mjs",
    "build:clinic": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pilot": "vitest run && tsc -b && vite build && node scripts/pilot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "dexie": "^4.0.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^2.1.9",
    "ws": "^8.21.2"
  }
}
